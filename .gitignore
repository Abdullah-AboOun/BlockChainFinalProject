# Root .gitignore for the monorepo

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variables
# .env
# .env.*

# Logs
logs/
*.log
*.out
*.err

# OS files
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# Build output
dist/
build/
tmp/
out/

# Monorepo lockfiles (ignore if you want to track them per-package)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Misc
coverage/
*.tgz
*.gz
*.zip
*.bak
*.tmp

# Hardhat / Ethereum artifacts (also ignored per-package)
artifacts/
cache/
typechain/


*.md